#include <stdio.h>

int isLeap(int y) {
    return (y % 4 == 0 && y % 100 != 0) || (y % 400 == 0);
}

int daysInMonth(int m, int y) {          /* m: 0 = Jan ... 11 = Dec */
    int d[] = {31,28,31,30,31,30,31,31,30,31,30,31};
    if (m == 1 && isLeap(y)) return 29;
    return d[m];
}

int firstDayOfYear(int y) {              /* 0 = Sunday ... 6 = Saturday */
    int p = y - 1;
    return (1 + 5 * (p % 4) + 4 * (p % 100) + 6 * (p % 400)) % 7;
}

int main() {
    const char *names[] = {"January","February","March","April","May","June",
                           "July","August","September","October","November","December"};
    int year, start, m, d, i;

    printf("Enter year: ");
    scanf("%d", &year);

    start = firstDayOfYear(year);

    for (m = 0; m < 12; m++) {
        printf("\n   ---- %s %d ----\n", names[m], year);
        printf(" Su Mo Tu We Th Fr Sa\n");

        for (i = 0; i < start; i++)
            printf("   ");

        for (d = 1; d <= daysInMonth(m, year); d++) {
            printf("%3d", d);
            if ((start + d) % 7 == 0)
                printf("\n");
        }
        start = (start + daysInMonth(m, year)) % 7;   /* carry to next month */
        printf("\n");
    }
    return 0;
}
